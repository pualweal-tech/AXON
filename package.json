{
  "name": "axon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate:legacy": "tsx server/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.21",
    "ical.js": "^2.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.13",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
