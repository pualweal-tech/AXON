# Required for production. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AXON_ENCRYPTION_KEY=
# Required on Vercel. Local Node defaults to ../.axon-data/axon.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Only set these if the deployment owner opts in to funding registered users.
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_MODEL=grok-3-mini
DEEPSEEK_MODEL=deepseek-chat
# Exact public origin (optional for a same-origin deployment)
APP_ORIGIN=
# Public sign-up verifies email through Resend. Use AXON_REGISTRATION=closed for invite-only/preprovisioned deployments.
RESEND_API_KEY=
AXON_MAIL_FROM=
AXON_REGISTRATION=open
